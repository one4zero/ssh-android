<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/term_panel"
    android:orientation="vertical">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/term_panel"
        android:minHeight="48dp"
        android:popupTheme="@android:style/ThemeOverlay.Material.Dark"
        android:subtitleTextAppearance="@android:style/TextAppearance.Material.Small"
        android:theme="@style/ToolbarTheme"
        android:titleTextAppearance="@android:style/TextAppearance.Material.Medium" />

    <FrameLayout
        android:id="@+id/terminal_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/term_bg">

        <com.one4zero.sshterm.terminal.TerminalView
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <LinearLayout
            android:id="@+id/selection_bar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_selection_bar"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/sel_copy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/copy"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sel_ai"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/for_ai"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sel_all"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/select_all"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/sel_paste"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/paste"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/sel_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/scroll_bottom"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_round_dark"
            android:contentDescription="@string/scroll_bottom"
            android:elevation="4dp"
            android:src="@drawable/ic_arrow_down"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/disconnected_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_selection_bar"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/disconnected_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="8"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_reconnect"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reconnect"
                android:textColor="@color/accent" />

            <ImageButton
                android:id="@+id/btn_close_session"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/snippets_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/snippets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/extra_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingTop="3dp"
        android:paddingEnd="2dp" />

    <LinearLayout
        android:id="@+id/command_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btn_mode"
            style="@style/BarButton"
            android:contentDescription="@string/toggle_input"
            android:src="@drawable/ic_keyboard" />

        <ImageButton
            android:id="@+id/btn_history"
            style="@style/BarButton"
            android:contentDescription="@string/history"
            android:src="@drawable/ic_history" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/command_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_command_input"
                android:fontFamily="monospace"
                android:hint="@string/command_hint"
                android:importantForAutofill="no"
                android:maxLines="6"
                android:minHeight="42dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:scrollHorizontally="false"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/term_hint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/direct_hint"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_command_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/direct_mode_hint"
                android:textColor="@color/term_hint"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_paste"
            style="@style/BarButton"
            android:contentDescription="@string/paste"
            android:src="@drawable/ic_paste" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_send"
            android:contentDescription="@string/send"
            android:focusable="false"
            android:paddingStart="4dp"
            android:src="@drawable/ic_send"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
